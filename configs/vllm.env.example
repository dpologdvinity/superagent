# OpenAI-compatible vLLM endpoint used by the R1 harness and the R2 pilot.
# Copy to configs/vllm.env (gitignored) and `set -a; . configs/vllm.env; set +a`
# before a run.  Never commit a real key.
#
# The default target is a local vLLM server:
#   vllm serve Qwen/Qwen3-8B-AWQ --max-model-len 8192 --port 8000
# The key is ignored by vLLM; it is "EMPTY" rather than a paid credential.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_TIMEOUT=180
VLLM_MAX_RETRIES=3
# auto: try native OpenAI tool calls, then the JSON text protocol.
# native: only OpenAI tool calls.  text: only the JSON text protocol.
VLLM_TOOL_MODE=auto
# Qwen3 hybrid thinking is disabled for code generation; set true only for an
# endpoint that supports chat_template_kwargs.
VLLM_ENABLE_THINKING=false
VLLM_TEMPERATURE=0.7
VLLM_TOP_P=0.95

# B3 uses a frontier baseline only if the operator supplies one.  Without these
# variables B3 reuses the generator endpoint/model at temperature 0.7, which is the
# $0-budget R1 behaviour.
# VLLM_FRONTIER_BASE_URL=https://example.invalid/v1
# VLLM_FRONTIER_API_KEY=
# VLLM_FRONTIER_MODEL=
# VLLM_FRONTIER_TIMEOUT=180
